{
  "name": "esport360-backend",
  "version": "1.1.0",
  "description": "ESport360 — REST API cho nền tảng đặt sân thể thao",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "migrate": "node scripts/migrate.js",
    "test": "node tests/transferPricing.test.js && node tests/creditAndPolicy.test.js && node tests/googleAuth.test.js && node tests/ownerPaymentFlow.test.js && node tests/commission.test.js && node tests/settlementMath.test.js && node tests/settlementFlow.test.js && node tests/avatars.test.js && node tests/courtRules.test.js && node tests/uploadsAndMail.test.js",
    "test:integration": "node tests/integration/booking-race.integration.test.js && node tests/integration/booking-expiry.integration.test.js && node tests/integration/credit-concurrency.integration.test.js && node tests/integration/transfer-flow.integration.test.js",
    "check-config": "node -e \"require('dotenv').config();require('./config/env').check()\""
  },
  "keywords": [
    "nodejs",
    "restful",
    "api",
    "esport360"
  ],
  "author": "FPTU HN",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
