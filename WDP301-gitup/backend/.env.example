# ============================================================
# ESPORT360 — BIẾN MÔI TRƯỜNG BACKEND
#
# Sao chép file này thành .env rồi điền giá trị thật:
#     cp .env.example .env
#
# KHÔNG BAO GIỜ commit file .env. Nếu lỡ commit, coi như mọi khoá
# trong đó đã lộ và phải đổi hết — kể cả khi đã xoá khỏi lịch sử git.
#
# Kiểm tra cấu hình trước khi chạy:  npm run check-config
# ============================================================

# ===== CƠ BẢN =====
NODE_ENV=production
PORT=9999

# Múi giờ của sân, tính bằng PHÚT so với UTC. Việt Nam = 420 (UTC+7).
# ⚠️ Đây KHÔNG phải cấu hình hiển thị: lead time quyết định bậc phí chuyển sân
# và bậc bồi thường chủ sân. Sai giá trị này là thu sai tiền của khách.
APP_TZ_OFFSET_MINUTES=420

# ===== CƠ SỞ DỮ LIỆU =====
# ⚠️ PRODUCTION BẮT BUỘC dùng replica set. Chuyển sân đụng tiền của ba bên nên
# không được phép thực thi nửa vời, mà giao dịch của MongoDB chỉ hoạt động trên
# replica set. Thiếu ?replicaSet=... thì máy chủ sẽ từ chối khởi động.
MONGO_URI=mongodb://mongo:27017/esport360?replicaSet=rs0

# ===== BẢO MẬT =====
# Sinh khoá mới bằng lệnh:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Tối thiểu 32 ký tự ở production. Đổi khoá này sẽ làm mọi phiên đăng nhập hiện
# tại hết hiệu lực — đó chính là điều bạn muốn nếu nghi ngờ khoá đã lộ.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Số lớp reverse proxy đứng trước ứng dụng (nginx = 1, nginx + Cloudflare = 2).
# Đặt sai sẽ khiến giới hạn tần suất đếm nhầm IP.
TRUST_PROXY_HOPS=1

# ===== TÊN MIỀN =====
CLIENT_URL=https://esport360.vn,https://www.esport360.vn
SERVER_URL=https://api.esport360.vn

UPLOAD_DIR=uploads

# Đặt false ở mọi instance trừ MỘT, khi chạy nhiều tiến trình song song.
RUN_JOBS=true

# ===== TÀI KHOẢN QUẢN TRỊ KHỞI TẠO =====
# Chỉ dùng cho lần chạy seed đầu tiên. Đổi mật khẩu ngay sau khi đăng nhập lần
# đầu, rồi xoá ba dòng này khỏi .env.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# ============================================================
# THANH TOÁN — CHUYỂN KHOẢN NGÂN HÀNG TRỰC TIẾP
#
# Thay cho VNPay/MoMo: không cần đăng ký merchant, không cần chờ duyệt hồ sơ.
#
# ⚠️ ĐƠN ĐẶT SÂN: khách chuyển khoản THẲNG vào tài khoản của CHỦ SÂN (chủ sân
# nhập ở Cài đặt → Thông tin nhận tiền) và CHỦ SÂN xác nhận. Tài khoản khai báo
# dưới đây là tài khoản của NỀN TẢNG và KHÔNG hiển thị khi khách đặt sân — chỉ
# dùng để thu khoản bù khi khách chuyển sân (do quản trị viên xác nhận).
#
# Các giá trị này cũng có thể cấu hình ngay trong trang Cài đặt (Admin) mà
# không cần sửa .env — biến môi trường ở đây chỉ dùng cho việc kiểm tra cấu
# hình lúc khởi động (npm run check-config) và cho lần chạy đầu tiên.
# ============================================================
# Mã BIN theo chuẩn Napas — bắt buộc để tạo được mã QR VietQR.
# Tra cứu miễn phí: https://api.vietqr.io/v2/banks (vd: ACB = 970416,
# Vietcombank = 970436, MB Bank = 970422, Techcombank = 970407)
BANK_BIN=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_NAME=

# ============================================================
# TỰ ĐỘNG XÁC NHẬN chủ sân đã nộp phí dịch vụ (tuỳ chọn)
# Đăng ký dịch vụ đọc sao kê (SePay https://sepay.vn hoặc Casso https://casso.vn), liên kết
# với tài khoản NỀN TẢNG ở trên, rồi cấu hình webhook:
#   URL:      https://<tên-miền-api>/api/webhooks/bank
#   Xác thực: API Key = đúng giá trị BANK_WEBHOOK_SECRET bên dưới
# Để trống = tắt (admin vẫn xác nhận tay được ở trang Đối soát). Dùng chuỗi ngẫu nhiên dài ≥ 24 ký tự.
BANK_WEBHOOK_SECRET=

# ============================================================
# EMAIL
# Thiếu phần này thì "Quên mật khẩu" trả lỗi 503 — người dùng quên mật khẩu sẽ
# mất tài khoản vĩnh viễn. Không bắt buộc để khởi động, nhưng nên có.
#
# Gợi ý: Gmail dùng "App Password" chứ không phải mật khẩu tài khoản, và giới
# hạn ~500 email/ngày. Lượng lớn hơn nên dùng SendGrid, Mailgun hoặc Amazon SES.
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ESport360 <no-reply@esport360.vn>

# ============================================================
# ĐĂNG NHẬP / ĐĂNG KÝ BẰNG GOOGLE
# ============================================================
# Tạo "OAuth 2.0 Client ID" loại Web application tại Google Cloud Console
# (APIs & Services → Credentials). Ở mục "Authorized JavaScript origins" thêm
# đúng domain frontend (vd. https://esport360.vn, và http://localhost:5173 khi
# chạy thử). KHÔNG cần Client Secret — hệ thống chỉ dùng ID token.
# Cùng giá trị này phải được truyền cho frontend lúc build: VITE_GOOGLE_CLIENT_ID.
# Để trống = tắt tính năng (nút Google tự ẩn, endpoint trả 503).
GOOGLE_CLIENT_ID=

# ============================================================
# EMAIL QUA BREVO (HTTP API) — dùng khi hosting chặn cổng SMTP
# (Render gói miễn phí chặn 25/465/587 nên SMTP ở trên KHÔNG chạy được).
# Brevo gói free: 300 email/ngày. Có đủ hai biến này thì Brevo được ưu tiên hơn SMTP.
#   BREVO_API_KEY: Brevo → SMTP & API → API Keys → Generate a new API key
#   MAIL_FROM:     địa chỉ đã xác minh ở Brevo → Senders, Domains & Dedicated IPs
# ============================================================
BREVO_API_KEY=
MAIL_FROM=ESport360 <email-da-xac-minh@gmail.com>

# ============================================================
# LƯU ẢNH TRÊN CLOUDINARY (ảnh sân, ảnh đại diện)
# Bắt buộc nếu hosting có ổ đĩa tạm (Render free...): không có thì ảnh MẤT sau mỗi lần restart.
# Lấy ở Cloudinary → Dashboard → "API Environment variable". Dạng:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# (hoặc điền 3 biến CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET)
# Để trống = ghi vào thư mục uploads/ như trước (máy cá nhân, VPS có ổ đĩa bền).
# ============================================================
CLOUDINARY_URL=

# Giấy tờ pháp lý của chủ sân (riêng tư) mặc định lưu trong MongoDB.
# Đặt PRIVATE_STORAGE=disk nếu muốn lưu ra thư mục private-uploads/ (chỉ hợp với VPS có ổ đĩa bền).
# PRIVATE_STORAGE=mongo
