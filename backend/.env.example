# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── MongoDB ─────────────────────────────────────────────
# URI kết nối MongoDB. Dùng replica set (rs0) để hỗ trợ transaction khi tạo booking.
# Khởi động container theo hướng dẫn README (docker run ... --replSet rs0).
MONGODB_URI=mongodb://localhost:27017/datsan247?replicaSet=rs0

# ── Auth (JWT) ──────────────────────────────────────────
ACCESS_TOKEN_SECRET=dev-access-token-secret
ACCESS_TOKEN_TTL_MINUTES=10080

# ── bcrypt ──────────────────────────────────────────────
BCRYPT_ROUNDS=10

# ── Admin seed (chạy `npm run seed:admin` để tạo tài khoản admin) ──
ADMIN_NAME=Quản Trị Viên
ADMIN_EMAIL=admin@e360sport.vn
ADMIN_PHONE=0900000001
ADMIN_PASSWORD=Admin@123456
